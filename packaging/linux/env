# cronos configuration. Read by the systemd unit as EnvironmentFile.
#
# In a file rather than in the unit because CRONOS_SIGNING_KEY is a secret and a
# unit is world-readable. This file is installed 0600 and owned by root; the
# package does not overwrite it on upgrade.
#
# Everything here is optional.
#
# Left empty, cronosd starts in setup mode and serves /setup, which writes
# /var/lib/cronos/config.yaml for you — including a signing key it generates.
# The server's log names a token file you will need to prove you are on this
# machine; nothing can be configured without it.
#
# Anything set here wins over that file, so this is where to pin a value you
# want to survive whatever setup wrote. Leave it commented to let setup decide.

# CRONOS_SIGNING_KEY=
# CRONOS_ORG=default
# CRONOS_PROJECT=default
# CRONOS_DEFINITIONS=/var/lib/cronos/definitions
# CRONOS_STORE_DSN=postgres://cronos:...@localhost/cronos?sslmode=disable

# Only where something in front terminates TLS. It keys rate limits on
# X-Forwarded-For and makes the SSO state cookie Secure.
# CRONOS_BEHIND_PROXY=1

# Arms schedules on this instance. Safe on every replica: they elect one leader
# per project and only the leader fires.
# CRONOS_SCHEDULER=1
