    "@vitejs/plugin-react": "^6.0.5",
    "oxlint": "^1.78.0",
    "playwright": "^1.50.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0"
