{
  "name": "@cronos/embed",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/cronos-embed.js",
  "module": "./dist/cronos-embed.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/cronos-embed.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/cronos-embed.js"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && oxlint src && bun run build && node scripts/size-check.mjs",
    "embed": "node scripts/embed-check.mjs",
    "lint": "oxlint src",
    "size": "vite build && node scripts/size-check.mjs",
    "vue": "bun build harness/vue-app.ts --outfile harness/vue-app.js && node scripts/vue-check.mjs"
  },
  "devDependencies": {
    "oxlint": "^1.78.0",
    "playwright": "^1.56.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.1",
    "vue": "^3.5.41"
  }
}
