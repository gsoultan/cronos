<?xml version="1.0" encoding="UTF-8"?>
<!--
  A JasperReports report over the demo warehouse (demo/seed.sql), so the
  importer can be tried without a Jasper estate to hand:

      go run ./cmd/cronos-import -datasource warehouse -out /tmp/imported examples/jasper

  It is deliberately ordinary: one query, two prompted dates, a customer group
  that breaks the page, a per-group subtotal, a report total, and a page number
  in the footer. That is the shape most of an operational estate takes, and all
  of it survives the import.

  The two elements that do not survive are here on purpose — a logo in the
  title band and a running page count — so a first run shows what a finding
  looks like rather than only what a success looks like.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              name="Monthly_Statement" language="java"
              pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              orientation="Portrait">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Warehouse"/>
	<style name="Title" fontName="Helvetica" fontSize="18" isBold="true"/>
	<style name="Column" fontName="Helvetica" fontSize="10" isBold="true"/>

	<parameter name="FROM_DATE" class="java.util.Date">
		<parameterDescription><![CDATA[From]]></parameterDescription>
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="TO_DATE" class="java.util.Date">
		<parameterDescription><![CDATA[To]]></parameterDescription>
	</parameter>

	<queryString>
		<![CDATA[SELECT c.name AS customer_name,
       i.issued_at,
       i.status,
       i.currency,
       i.total
FROM invoices i
JOIN customers c ON c.id = i.customer_id
WHERE i.issued_at BETWEEN $P{FROM_DATE} AND $P{TO_DATE}]]>
	</queryString>

	<field name="customer_name" class="java.lang.String">
		<fieldDescription><![CDATA[Customer]]></fieldDescription>
	</field>
	<field name="issued_at" class="java.sql.Date"/>
	<field name="status" class="java.lang.String"/>
	<field name="currency" class="java.lang.String"/>
	<field name="total" class="java.math.BigDecimal"/>

	<sortField name="issued_at" order="Ascending"/>

	<variable name="CUSTOMER_TOTAL" class="java.math.BigDecimal"
	          resetType="Group" resetGroup="CustomerGroup" calculation="Sum">
		<variableExpression><![CDATA[$F{total}]]></variableExpression>
	</variable>
	<variable name="GRAND_TOTAL" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{total}]]></variableExpression>
	</variable>

	<group name="CustomerGroup" isStartNewPage="true">
		<groupExpression><![CDATA[$F{customer_name}]]></groupExpression>
		<groupHeader>
			<band height="26">
				<textField>
					<reportElement x="0" y="0" width="330" height="20"/>
					<textElement><font size="12" isBold="true"/></textElement>
					<textFieldExpression><![CDATA[$F{customer_name}]]></textFieldExpression>
				</textField>
			</band>
		</groupHeader>
		<groupFooter>
			<band height="22">
				<staticText>
					<reportElement x="230" y="0" width="110" height="20"/>
					<text><![CDATA[Customer total]]></text>
				</staticText>
				<textField pattern="¤#,##0.00">
					<reportElement x="350" y="0" width="100" height="20"/>
					<textFieldExpression><![CDATA[$V{CUSTOMER_TOTAL}]]></textFieldExpression>
				</textField>
			</band>
		</groupFooter>
	</group>

	<title>
		<band height="66">
			<!-- Not carried: an image is reported, and belongs in the paginated
			     output's Typst header template instead. -->
			<image>
				<reportElement x="455" y="0" width="100" height="40"/>
				<imageExpression><![CDATA["logo.png"]]></imageExpression>
			</image>
			<staticText>
				<reportElement style="Title" x="0" y="8" width="400" height="30"/>
				<textElement><font size="18" isBold="true"/></textElement>
				<text><![CDATA[Monthly Statement]]></text>
			</staticText>
		</band>
	</title>

	<columnHeader>
		<band height="20">
			<staticText>
				<reportElement style="Column" x="0" y="0" width="110" height="20"/>
				<text><![CDATA[Issued]]></text>
			</staticText>
			<staticText>
				<reportElement style="Column" x="120" y="0" width="100" height="20"/>
				<text><![CDATA[Status]]></text>
			</staticText>
			<staticText>
				<reportElement style="Column" x="350" y="0" width="100" height="20"/>
				<text><![CDATA[Amount]]></text>
			</staticText>
		</band>
	</columnHeader>

	<detail>
		<band height="20">
			<textField pattern="dd/MM/yyyy">
				<reportElement x="0" y="0" width="110" height="20"/>
				<textFieldExpression><![CDATA[$F{issued_at}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="120" y="0" width="100" height="20"/>
				<textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
			</textField>
			<textField pattern="¤#,##0.00">
				<reportElement x="350" y="0" width="100" height="20"/>
				<textFieldExpression><![CDATA[$F{total}]]></textFieldExpression>
			</textField>
		</band>
	</detail>

	<pageFooter>
		<band height="20">
			<textField>
				<reportElement x="400" y="0" width="90" height="20"/>
				<textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of "]]></textFieldExpression>
			</textField>
			<textField evaluationTime="Report">
				<reportElement x="490" y="0" width="40" height="20"/>
				<textFieldExpression><![CDATA[$V{PAGE_COUNT}]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>

	<summary>
		<band height="30">
			<staticText>
				<reportElement x="230" y="4" width="110" height="20"/>
				<text><![CDATA[Total billed]]></text>
			</staticText>
			<textField pattern="¤#,##0.00">
				<reportElement x="350" y="4" width="100" height="20"/>
				<textFieldExpression><![CDATA[$V{GRAND_TOTAL}]]></textFieldExpression>
			</textField>
		</band>
	</summary>
</jasperReport>
