bin/
# And the same binaries built into the tree instead. `go build ./cmd/cronosd`
# with no -o writes to the working directory, so a 20MB file lands beside the
# source and is one `git add -A` away from the history.
/cronosd
/cronosd-ee
/cronos-import
/cronos-token
/cronos-user
# Release archives and the portal build, both reproducible from a tag.
dist/
node_modules/
shots/
packages/*/harness/*.js

# Local env overrides
.env
.env.local

.DS_Store

# A development deployment: accounts, and the database they live in.
.dev/

# Agent tooling: graphify's code graph and Serena's index and notes. Both are
# built locally, and graphify-out/ is regenerated wholesale — one `git add -A`
# from putting one machine's graph in the history. .dockerignore already keeps
# them out of the image context; this keeps them out of commits. Knowledge
# meant to be shared belongs in AGENTS.md and docs/, where it is reviewed.
graphify-out/
.serena/
