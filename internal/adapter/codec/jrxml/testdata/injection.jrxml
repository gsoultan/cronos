<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" name="sales_by_column">
	<parameter name="SORT_COLUMN" class="java.lang.String">
		<defaultValueExpression><![CDATA["issued_at"]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[SELECT id, total FROM invoices ORDER BY $P!{SORT_COLUMN}]]></queryString>
	<field name="id" class="java.lang.String"/>
	<field name="total" class="java.math.BigDecimal"/>
	<detail><band height="20">
		<textField><reportElement x="0" y="0" width="100" height="20"/>
			<textFieldExpression><![CDATA[$F{id}]]></textFieldExpression></textField>
	</band></detail>
</jasperReport>
