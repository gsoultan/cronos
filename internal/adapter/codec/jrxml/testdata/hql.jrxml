<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" name="hibernate_report">
	<queryString language="hql"><![CDATA[from Invoice i where i.status = :status]]></queryString>
	<field name="id" class="java.lang.String"/>
	<detail><band height="20">
		<textField><reportElement x="0" y="0" width="100" height="20"/>
			<textFieldExpression><![CDATA[$F{id}]]></textFieldExpression></textField>
	</band></detail>
</jasperReport>
