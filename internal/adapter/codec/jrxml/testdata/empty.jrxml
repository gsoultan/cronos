<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" name="container_only">
	<queryString><![CDATA[SELECT id FROM invoices]]></queryString>
	<field name="id" class="java.lang.String"/>
	<detail>
		<band height="200">
			<subreport>
				<reportElement x="0" y="0" width="555" height="200"/>
				<subreportExpression><![CDATA["lines.jasper"]]></subreportExpression>
			</subreport>
		</band>
	</detail>
</jasperReport>
